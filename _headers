# AK PRIME - réponses des fichiers destinés aux robots (Cloudflare Pages).
# Ces règles s'appliquent uniquement aux fichiers statiques.
# Elles ne contournent aucune protection anti-bot ou firewall.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=300

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
